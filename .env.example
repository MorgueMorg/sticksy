# OpenRouter (or OpenAI-compatible API) — для идей и имён стикеров
# Примеры моделей: openai/gpt-4o-mini, anthropic/claude-3-haiku, google/gemini-flash-1.5
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Альтернатива: OpenAI
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# remove.bg — для удаления фона (необязательно). Ключ: remove.bg/api
REMOVEBG_API_KEY=9DGeWkggmYWiSGTn2KNiqUbm
